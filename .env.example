# ==============================================================================
# OpenPaperCheck Environment Configuration Template
# Copy this file to .env and fill in the values for your environment.
# ==============================================================================

# Runtime Environment (dev, staging, prod)
OPC_ENV=dev

# Application Secret Key (generate 32+ random bytes for production)
SECRET_KEY=dev-secret-key-change-this-in-production-minimum-32-bytes

# Public Site URL
PUBLIC_BASE_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# Data Sources
# ------------------------------------------------------------------------------
# Your email for Crossref Polite Pool (required for polite rate limits)
CROSSREF_MAILTO=dev-contact@example.org

# OpenAlex API Key (Optional for CLI; required if using OpenAlex fallback in backend)
OPENALEX_API_KEY=

# ------------------------------------------------------------------------------
# Database & Queues (Server/Platform only - CLI does not need this)
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql+psycopg://opc:opc@localhost:5432/opc

# ------------------------------------------------------------------------------
# Authentication (Google OIDC & Magic Links)
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Transactional Email (Resend SMTP / API for magic links)
RESEND_API_KEY=
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=no-reply@openpapercheck.org

# Cloudflare Turnstile (Anti-abuse bot protection for signups/appeals)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=

# ------------------------------------------------------------------------------
# Observability & Monitoring
# ------------------------------------------------------------------------------
SENTRY_DSN=

# ------------------------------------------------------------------------------
# Evidence-Card LLM Agent (Optional, Week 8+)
# ------------------------------------------------------------------------------
LLM_PROVIDER=none # anthropic, openai_compat, none
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# ------------------------------------------------------------------------------
# Off-Site Encrypted Backups (S3-compatible)
# ------------------------------------------------------------------------------
BACKUP_S3_ENDPOINT=
BACKUP_S3_BUCKET=
BACKUP_S3_KEY=
BACKUP_S3_SECRET=
